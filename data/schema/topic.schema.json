        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "text",
              "needs"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "text": {
                "description": "卡片文字，{place} {time} {saved} {origin} {constraint} 由網站代入。",
                "type": "string"
              },
              "needs": {
                "description": "text 用到的代入欄位。",
                "type": "array",
                "items": {
                  "enum": [
                    "place",
                    "time",
                    "saved",
                    "origin",
                    "constraint"
                  ]
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "sim_badge": {
          "description": "用到模擬數字時，印在卡片角落的文字，如 含模擬資料。不能只靠斜線紋路。",
          "type": "string"
        },
        "footer": {
          "description": "卡片底部文字，如 作品網址。",
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "limits": {
      "description": "「我們可能錯在哪」頁：最可能推翻結論的地方，以及目前的處理。",
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "why",
              "handling",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "why": {
                "description": "為什麼可能錯。",
                "type": "string"
              },
              "handling": {
                "description": "我們目前怎麼處理。",
                "type": "string"
              },
              "status": {
                "description": "handled 已處理、partial 部分處理、open 尚未處理。",
                "enum": [
                  "handled",
                  "partial",
                  "open"
                ]
              }
            }
          }
        }
      }
    }
  }
}
