{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YasmineCheng-Advantech/taipei-hackathon-2026/data/schema/topic.schema.json",
  "title": "題目資料檔（資料契約 v1）",
  "description": "網站只透過這份契約讀資料。v1 定版後只能新增欄位，不改名、不刪欄位。欄位用途與換題規則見同資料夾的 README.md；跨欄位的檢查（格子數量、id 參照）由 validate.py 負責。",
  "type": "object",
  "required": [
    "meta",
    "heatmap",
    "kpis",
    "decide",
    "collective",
    "scenario",
    "city",
    "brief"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "heatmap": {
      "$ref": "#/$defs/heatmap"
    },
    "kpis": {
      "description": "Main 上方的 3 張重點數字卡。",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/kpi"
      }
    },
    "decide": {
      "$ref": "#/$defs/decide"
    },
    "collective": {
      "$ref": "#/$defs/collective"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "city": {
      "$ref": "#/$defs/city"
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "share": {
      "$ref": "#/$defs/share"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "$defs": {
    "id": {
      "description": "小寫英數、底線、連字號。",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "hhmm": {
      "description": "24 小時制時間，如 07:45。",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "label": {
      "description": "資料標示：observed 真實觀測、computed 程式計算、assumed 情境假設、ai AI 生成。",
      "enum": [
        "observed",
        "computed",
        "assumed",
        "ai"
      ]
    },
    "tag": {
      "description": "硬規則：帶數字的最小物件都要有 label 與 sim。",
      "type": "object",
      "required": [
        "label",
        "sim"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "sim": {
          "description": "是否為模擬資料；true 時畫面加斜線紋路。",
          "type": "boolean"
        },
        "src": {
          "description": "資料來源，填 meta.sources 裡的 id。",
          "$ref": "#/$defs/id"
        }
      }
    },
    "num": {
      "description": "一個帶標示的數字。單一值填 value；區間填 lo 與 hi（可同時給 value 當中間值）；還沒有數字時填 pending: true，網站顯示「待補」。",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/tag"
        }
      ],
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "lo",
            "hi"
          ]
        },
        {
          "required": [
            "pending"
          ]
        }
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "lo": {
          "type": "number"
        },
        "hi": {
          "type": "number"
        },
        "pending": {
          "description": "還沒有數字，網站顯示「待補」。",
          "const": true
        },
        "unit": {
          "description": "顯示用單位，如 分、%、人、輛。",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "label": true,
        "sim": true,
        "src": true
      },
      "additionalProperties": false
    },
    "cell": {
      "description": "熱力格與曲線上的一個點。有值時帶 label 與 sim；沒有資料時只放 gap: true，不補值。 多天資料時可加 lo、hi、days、bad_days，讓畫面呈現每天的變動，而不只是平均。",
      "oneOf": [
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/tag"
            }
          ],
          "required": [
            "v"
          ],
          "properties": {
            "v": {
              "type": "number"
            },
            "label": true,
            "sim": true,
            "src": true,
            "lo": {
              "description": "各天的最小值（多天資料時才有）。",
              "type": "number"
            },
            "hi": {
              "description": "各天的最大值（多天資料時才有）。",
              "type": "number"
            },
            "days": {
              "description": "這一格有資料的天數。",
              "type": "integer",
              "minimum": 1
            },
            "bad_days": {
              "description": "達到所屬圖層 bad_at 的天數，網站顯示「N 天裡有 M 天會塞」。",
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "gap"
          ],
          "properties": {
            "gap": {
              "const": true
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "col": {
      "description": "一個時段（或其他欄位，如停車題的小時）。",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "description": "欄首顯示文字，如 07:15。",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/hhmm"
        },
        "end": {
          "$ref": "#/$defs/hhmm"
        }
      }
    },
    "meta": {
      "description": "所有頁面的頁首與頁尾。",
      "type": "object",
      "required": [
        "contract_version",
        "id",
        "title",
        "region",
        "time_range",
        "bin_minutes",
        "sources",
        "updated_at",
        "sim"
      ],
      "properties": {
        "contract_version": {
          "description": "契約版本，v1 期間固定 1.x。",
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "id": {
          "description": "題目 id，同時是網址參數 ?topic= 與檔名，如 t4-morning。",
          "$ref": "#/$defs/id"
        },
        "title": {
          "description": "題目名稱，如 內科晨峰車流。",
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "region": {
          "description": "地區，如 內湖科技園區。",
          "type": "string"
        },
        "days": {
          "description": "適用日別，如 平日。",
          "type": "string"
        },
        "time_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/hhmm"
            },
            "end": {
              "$ref": "#/$defs/hhmm"
            }
          }
        },
        "bin_minutes": {
          "description": "時間格長度（分鐘），如 15。",
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "description": "這份檔案用到的所有資料來源；其他區塊用 src 參照這裡的 id。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "description": "real 真實開放資料、mock 模擬、survey 調查、model 模型輸出。",
                "enum": [
                  "real",
                  "mock",
                  "survey",
                  "model"
                ]
              },
              "url": {
                "type": "string"
              },
              "period": {
                "description": "資料期間，如 2026-10-19～10-23 07:00–10:30。",
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "updated_at": {
          "description": "產出時間，ISO 8601，如 2026-10-19T12:00:00+08:00。",
          "type": "string"
        },
        "sim": {
          "description": "整份檔案是否為模擬資料。true 時檔內所有 sim 都必須是 true。",
          "type": "boolean"
        },
        "mock_method": {
          "description": "模擬方法說明（sim 為 true 時必填）。",
          "type": "string"
        },
        "disclaimer": {
          "description": "頁尾聲明，如 本作品之建議不代表市府立場。",
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "sim": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "mock_method"
        ]
      }
    },
    "heatmap": {
      "description": "Main 熱力儀表板：地點 × 時段矩陣、圖層、示意圖。",
      "type": "object",
      "required": [
        "rows",
        "cols",
        "layers",
        "default_layer"
      ],
      "properties": {
        "title": {
          "description": "頁面大標，如 早上八點半，車都卡在哪裡？",
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "rows": {
          "description": "地點（入口、路段、停車場、行政區…）。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "description": "如 堤頂大道。",
                "type": "string"
              },
              "sub": {
                "description": "方向或補充，如 北向、往內湖。",
                "type": "string"
              },
              "kind": {
                "description": "這一列的資料狀態，對應列首標籤：observed 真實觀測、sim 模擬、gap 無資料。",
                "enum": [
                  "observed",
                  "sim",
                  "gap"
                ]
              },
              "x": {
                "description": "示意圖座標（0–100，非比例）。",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              },
              "src": {
                "$ref": "#/$defs/id"
              },
              "detector": {
                "description": "偵測器或資料編號，如 VD 編號。",
                "type": "string"
              }
            }
          }
        },
        "cols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/col"
          }
        },
        "layers": {
          "description": "可切換的圖層，如 車速、流量。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "unit",
              "direction",
              "thresholds",
              "cells"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "description": "切換鈕文字，如 壅塞（車速）。",
                "type": "string"
              },
              "unit": {
                "description": "格內數字的單位說明，如 平均車速 km/h。",
                "type": "string"
              },
              "direction": {
                "description": "low_is_bad：數字越小越嚴重（車速）；high_is_bad：越大越嚴重（流量、佔用率）。",
                "enum": [
                  "low_is_bad",
                  "high_is_bad"
                ]
              },
              "thresholds": {
                "description": "5 個分界點，切成 6 級色階（0 最輕、5 最嚴重），由輕到重排列。",
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "number"
                }
              },
              "legend": {
                "description": "6 級圖例文字。",
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "string"
                }
              },
              "legend_ends": {
                "description": "圖例兩端文字，如 [\"順\", \"塞 km/h\"]。",
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "level_text": {
                "description": "選取格子時的一句話，6 級各一句。",
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "string"
                }
              },
              "cells": {
                "description": "rows × cols 的二維陣列，順序與 rows、cols 相同。",
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/cell"
                  }
                }
              },
              "bad_at": {
                "description": "達到這個值就算「塞」，用來數 cells 的 bad_days；low_is_bad 時是低於、high_is_bad 時是高於這個值。",
                "type": "number"
              }
            }
          }
        },
        "default_layer": {
          "$ref": "#/$defs/id"
        },
        "landmarks": {
          "description": "示意圖上的地標文字，如 基隆河。",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "x",
              "y"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        },
        "aux": {
          "description": "矩陣旁的副圖，如 文湖線負載。值依 heatmap.cols 排列。",
          "type": "object",
          "required": [
            "title",
            "unit",
            "values"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "alert_at": {
              "description": "達到此值就加深顯示。",
              "type": "number"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "days_label": {
          "description": "多天資料的說明，如 4 個平日（10/20–10/23）。",
          "type": "string"
        }
      }
    },
    "kpi": {
      "type": "object",
      "required": [
        "id",
        "title",
        "value",
        "label",
        "sim"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/tag"
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "description": "如 最塞的一格。",
          "type": "string"
        },
        "value": {
          "description": "主數字或短字串，如 08:30–09:15、3 / 8。",
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        },
        "note": {
          "description": "一句說明。",
          "type": "string"
        },
        "ref": {
          "description": "點卡片時要跳到的格子（選填）。",
          "type": "object",
          "properties": {
            "row": {
              "$ref": "#/$defs/id"
            },
            "col": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "decide": {
      "description": "V2Setup、V2Today、A*App：幫你決定。依使用者設定選一份 plan。",
      "type": "object",
      "required": [
        "metric",
        "setup",
        "plans"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "metric": {
          "description": "選項比較的代價指標，如 路上時間（分）；停車題改成 步行（分）。",
          "type": "object",
          "required": [
            "name",
            "unit"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "setup": {
          "description": "第一次設定畫面的選項。",
          "type": "object",
          "required": [
            "rows"
          ],
          "properties": {
            "rows": {
              "description": "可選的地點，填 heatmap.rows 的 id。",
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "deadlines": {
              "description": "最晚到達時間選項。",
              "type": "array",
              "items": {
                "$ref": "#/$defs/hhmm"
              }
            },
            "flex": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "allows"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "label": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "allows": {
                    "description": "網站據此篩掉不符合的選項。",
                    "enum": [
                      "both",
                      "earlier",
                      "later",
                      "none"
                    ]
                  }
                }
              }
            },
            "origins": {
              "description": "設定第一步：從哪裡出發。選了之後只列出對應的入口；rows 為空代表目前沒有資料可以給建議，網站顯示 note。",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "rows"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "label": {
                    "description": "如 新店／文山。",
                    "type": "string"
                  },
                  "region": {
                    "description": "所屬縣市，如 新北市，用來彙總「多少人來自新北」。",
                    "type": "string"
                  },
                  "rows": {
                    "description": "常經過的入口，填 setup.rows 的 id。",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "note": {
                    "description": "補充說明，如 走基隆路接麥帥橋的人目前沒有資料。",
                    "type": "string"
                  }
                }
              }
            },
            "constraints": {
              "description": "「為什麼沒辦法錯峰」的選項，可複選、可不填。彙總後放在 city.breakdowns，並連到對應的城市行動。",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "label": {
                    "description": "如 要接送小孩。",
                    "type": "string"
                  },
                  "actions": {
                    "description": "這個原因對應的城市行動，填 city.actions 的 id。",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "share_text": {
                    "description": "分享卡「我想錯峰，但…」用的句子，如 要先送小孩去幼兒園。",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "plans": {
          "description": "每個 地點 × 最晚到達 一份；沒有 deadlines 時 deadline 省略。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "row",
              "options",
              "recommended",
              "baseline"
            ],
            "properties": {
              "row": {
                "$ref": "#/$defs/id"
              },
              "deadline": {
                "$ref": "#/$defs/hhmm"
              },
              "recommended": {
                "description": "推薦選項的 id。",
                "$ref": "#/$defs/id"
              },
              "baseline": {
                "description": "平常基準選項的 id，如 平常 08:15 經過入口。",
                "$ref": "#/$defs/id"
              },
              "reason": {
                "description": "推薦理由。",
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "key",
                    "cost",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "key": {
